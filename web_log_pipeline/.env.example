# 이 파일을 .env 로 복사하면 설정을 바꿀 수 있습니다. (.env 가 없으면 아래 기본값으로 실행됩니다)

# 브라우저에서 monitor에 접속할 포트 (8000이 사용 중이면 8080 등으로 변경)
MONITOR_PORT=8000

# producer가 이벤트를 보내는 간격(초)
PRODUCER_INTERVAL_SECONDS=0.5

# 보낼 이벤트 수 (0이면 멈출 때까지 계속)
MAX_EVENTS=0

# 평소 에러 비율 / 장애 모드일 때 /orders 에러 비율
ERROR_RATE=0.03
FAULT_ERROR_RATE=0.8
